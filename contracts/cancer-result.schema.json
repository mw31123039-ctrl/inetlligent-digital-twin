{
  "$defs": {
    "Confidence": {
      "additionalProperties": false,
      "description": "How strongly the model prefers its top category. Not a personal probability of cancer.",
      "properties": {
        "top_label": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Top Label",
          "type": "string"
        },
        "probability": {
          "maximum": 1,
          "minimum": 0,
          "title": "Probability",
          "type": "number"
        },
        "level": {
          "enum": [
            "high",
            "moderate",
            "low"
          ],
          "title": "Level",
          "type": "string"
        },
        "calibration": {
          "enum": [
            "temperature-scaled",
            "none"
          ],
          "title": "Calibration",
          "type": "string"
        },
        "temperature": {
          "anyOf": [
            {
              "maximum": 20,
              "minimum": 0.05,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Temperature"
        },
        "decision_threshold": {
          "maximum": 1,
          "minimum": 0,
          "title": "Decision Threshold",
          "type": "number"
        },
        "normalized_entropy": {
          "maximum": 1,
          "minimum": 0,
          "title": "Normalized Entropy",
          "type": "number"
        },
        "margin": {
          "maximum": 1,
          "minimum": 0,
          "title": "Margin",
          "type": "number"
        },
        "interpretation": {
          "const": "model-confidence-not-personal-risk",
          "title": "Interpretation",
          "type": "string"
        }
      },
      "required": [
        "top_label",
        "probability",
        "level",
        "calibration",
        "decision_threshold",
        "normalized_entropy",
        "margin",
        "interpretation"
      ],
      "title": "Confidence",
      "type": "object"
    },
    "Familiarity": {
      "additionalProperties": false,
      "description": "Similarity of the image embedding to embeddings of the model's own reference images.",
      "properties": {
        "method": {
          "const": "class-centroid-cosine",
          "title": "Method",
          "type": "string"
        },
        "similarity": {
          "maximum": 1,
          "minimum": -1,
          "title": "Similarity",
          "type": "number"
        },
        "minimum_similarity": {
          "maximum": 1,
          "minimum": -1,
          "title": "Minimum Similarity",
          "type": "number"
        },
        "familiar": {
          "title": "Familiar",
          "type": "boolean"
        }
      },
      "required": [
        "method",
        "similarity",
        "minimum_similarity",
        "familiar"
      ],
      "title": "Familiarity",
      "type": "object"
    },
    "Heatmap": {
      "additionalProperties": false,
      "properties": {
        "method": {
          "enum": [
            "grad-cam",
            "attention-rollout",
            "occlusion-sensitivity"
          ],
          "title": "Method",
          "type": "string"
        },
        "target_label": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Target Label",
          "type": "string"
        },
        "class_specific": {
          "title": "Class Specific",
          "type": "boolean"
        },
        "grid_width": {
          "maximum": 32,
          "minimum": 2,
          "title": "Grid Width",
          "type": "integer"
        },
        "grid_height": {
          "maximum": 32,
          "minimum": 2,
          "title": "Grid Height",
          "type": "integer"
        },
        "values": {
          "items": {
            "maximum": 1,
            "minimum": 0,
            "type": "number"
          },
          "maxItems": 1024,
          "minItems": 4,
          "title": "Values",
          "type": "array"
        },
        "meaning": {
          "enum": [
            "regions-that-raised-the-score",
            "patches-the-model-attended-to",
            "score-drop-under-occlusion"
          ],
          "title": "Meaning",
          "type": "string"
        },
        "localization": {
          "const": false,
          "title": "Localization",
          "type": "boolean"
        }
      },
      "required": [
        "method",
        "target_label",
        "class_specific",
        "grid_width",
        "grid_height",
        "values",
        "meaning",
        "localization"
      ],
      "title": "Heatmap",
      "type": "object"
    },
    "ImageChecks": {
      "additionalProperties": false,
      "properties": {
        "width": {
          "maximum": 2048,
          "minimum": 32,
          "title": "Width",
          "type": "integer"
        },
        "height": {
          "maximum": 2048,
          "minimum": 32,
          "title": "Height",
          "type": "integer"
        },
        "brightness": {
          "maximum": 255,
          "minimum": 0,
          "title": "Brightness",
          "type": "number"
        },
        "contrast": {
          "maximum": 128,
          "minimum": 0,
          "title": "Contrast",
          "type": "number"
        },
        "sharpness": {
          "minimum": 0,
          "title": "Sharpness",
          "type": "number"
        },
        "colored_fraction": {
          "maximum": 1,
          "minimum": 0,
          "title": "Colored Fraction",
          "type": "number"
        },
        "overexposed_fraction": {
          "maximum": 1,
          "minimum": 0,
          "title": "Overexposed Fraction",
          "type": "number"
        },
        "decision": {
          "enum": [
            "accepted",
            "accepted-with-warnings",
            "rejected"
          ],
          "title": "Decision",
          "type": "string"
        },
        "findings": {
          "items": {
            "$ref": "#/$defs/InputCheck"
          },
          "maxItems": 12,
          "title": "Findings",
          "type": "array"
        }
      },
      "required": [
        "width",
        "height",
        "brightness",
        "contrast",
        "sharpness",
        "colored_fraction",
        "overexposed_fraction",
        "decision",
        "findings"
      ],
      "title": "ImageChecks",
      "type": "object"
    },
    "InputCheck": {
      "additionalProperties": false,
      "description": "One observation about the image. 'limiting' makes the finding inconclusive; 'reject' stops analysis.",
      "properties": {
        "code": {
          "enum": [
            "blank-image",
            "low-contrast",
            "overexposed",
            "bright-areas",
            "very-dark",
            "dark",
            "severe-blur",
            "blur",
            "unexpected-color",
            "color-content",
            "unexpected-grayscale",
            "weak-color",
            "small-image",
            "elongated-image",
            "face-detected",
            "content-not-verified"
          ],
          "title": "Code",
          "type": "string"
        },
        "severity": {
          "enum": [
            "info",
            "warning",
            "limiting",
            "reject"
          ],
          "title": "Severity",
          "type": "string"
        },
        "message": {
          "maxLength": 240,
          "minLength": 1,
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "code",
        "severity",
        "message"
      ],
      "title": "InputCheck",
      "type": "object"
    },
    "ModelInfo": {
      "additionalProperties": false,
      "properties": {
        "source_url": {
          "maxLength": 500,
          "pattern": "^https://[^\\s]+$",
          "title": "Source Url",
          "type": "string"
        },
        "license": {
          "maxLength": 120,
          "minLength": 1,
          "title": "License",
          "type": "string"
        },
        "evaluation_reference": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Evaluation Reference",
          "type": "string"
        },
        "patient_disjoint": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "title": "Patient Disjoint"
        }
      },
      "required": [
        "source_url",
        "license",
        "evaluation_reference",
        "patient_disjoint"
      ],
      "title": "ModelInfo",
      "type": "object"
    },
    "Score": {
      "additionalProperties": false,
      "properties": {
        "label": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "value": {
          "maximum": 1,
          "minimum": 0,
          "title": "Value",
          "type": "number"
        }
      },
      "required": [
        "label",
        "value"
      ],
      "title": "Score",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "humantwin-cancer-result-v2",
      "title": "Schema Version",
      "type": "string"
    },
    "track": {
      "enum": [
        "skin",
        "oral",
        "lung",
        "breast"
      ],
      "title": "Track",
      "type": "string"
    },
    "modality": {
      "enum": [
        "skin_photo",
        "dermoscopy",
        "oral_photo",
        "lung_ct_slice",
        "mammogram",
        "breast_ultrasound",
        "breast_mri_slice"
      ],
      "title": "Modality",
      "type": "string"
    },
    "model_version": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,79}$",
      "title": "Model Version",
      "type": "string"
    },
    "target": {
      "maxLength": 160,
      "minLength": 1,
      "title": "Target",
      "type": "string"
    },
    "weights_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Weights Sha256",
      "type": "string"
    },
    "input_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Input Sha256",
      "type": "string"
    },
    "outcome": {
      "enum": [
        "finding",
        "inconclusive",
        "input-rejected"
      ],
      "title": "Outcome",
      "type": "string"
    },
    "outcome_reasons": {
      "items": {
        "enum": [
          "input-rejected",
          "input-quality",
          "low-confidence",
          "unfamiliar-image"
        ],
        "type": "string"
      },
      "maxItems": 4,
      "title": "Outcome Reasons",
      "type": "array"
    },
    "finding_label": {
      "anyOf": [
        {
          "maxLength": 80,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Finding Label"
    },
    "scores": {
      "items": {
        "$ref": "#/$defs/Score"
      },
      "maxItems": 20,
      "title": "Scores",
      "type": "array"
    },
    "confidence": {
      "anyOf": [
        {
          "$ref": "#/$defs/Confidence"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "familiarity": {
      "anyOf": [
        {
          "$ref": "#/$defs/Familiarity"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "heatmap": {
      "anyOf": [
        {
          "$ref": "#/$defs/Heatmap"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "image_checks": {
      "$ref": "#/$defs/ImageChecks"
    },
    "clinical_validation": {
      "const": false,
      "title": "Clinical Validation",
      "type": "boolean"
    },
    "calibrated_cancer_probability": {
      "const": false,
      "title": "Calibrated Cancer Probability",
      "type": "boolean"
    },
    "scope": {
      "const": "single-2d-image",
      "title": "Scope",
      "type": "string"
    },
    "external_requests": {
      "const": false,
      "title": "External Requests",
      "type": "boolean"
    },
    "inference_ms": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Inference Ms"
    },
    "runtime": {
      "anyOf": [
        {
          "enum": [
            "onnxruntime-cpu",
            "opencv-cpu"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Runtime"
    },
    "model_info": {
      "anyOf": [
        {
          "$ref": "#/$defs/ModelInfo"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "schema_version",
    "track",
    "modality",
    "model_version",
    "target",
    "weights_sha256",
    "input_sha256",
    "outcome",
    "outcome_reasons",
    "scores",
    "image_checks",
    "clinical_validation",
    "calibrated_cancer_probability",
    "scope",
    "external_requests"
  ],
  "title": "CancerResult",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
