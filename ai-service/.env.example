SERVICE_KEY=
AI_PROVIDER=disabled
OPENAI_API_KEY=
OPENAI_MODEL=
AI_TIMEOUT_SECONDS=18
RETRIEVAL_TIMEOUT_SECONDS=4
# Set only after approved provider data-processing terms and an explicit user disclosure.
ALLOW_EXTERNAL_AI=false
# Dental photographs use this local model, independently of the general AI provider.
DENTAL_LOCAL_MODEL_DIR=models/dental-local
DENTAL_PUBLIC_MODEL_DIR=models/dental-public
DENTAL_LEARNING_DIR=training-data/app
# Independently evaluated, operator-installed 2D ONNX classifiers; no models bundled.
CANCER_MODEL_DIR=models/cancer
CANCER_KNOWLEDGE_MODEL_DIR=models/cancer-knowledge

# Tracked temperature/threshold/familiarity values written by scripts/evaluate-cancer-models.py.
CANCER_CALIBRATION_PATH=calibration/cancer-calibration.json

# Clinical assessment v2 (/v2/clinical/*) is local and deterministic by default.
# Optional: closed-vocabulary symptom extraction by an external model (requires ALLOW_EXTERNAL_AI=true and OPENAI_API_KEY).
CLINICAL_LM_PROVIDER=disabled
CLINICAL_LM_MODEL=
